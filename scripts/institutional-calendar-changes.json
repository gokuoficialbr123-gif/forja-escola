  "after": "<style id=\"forja-institutional-style\">\n#institutionalNewUser select,#institutionalUserLink select{width:100%;min-width:0;min-height:44px;padding:10px;border:1px solid #dce2e7;border-radius:8px;background:#fff;color:#14334a;box-sizing:border-box}\n#institutionalNewUser small{display:block;line-height:1.5;color:#5b6871;overflow-wrap:anywhere}\n#institutionalUserLink{margin-top:18px;display:grid;gap:12px;min-width:0}\n#institutionalUserLink h3,#institutionalUserLink p{margin:0}\n[data-institutional-row]{margin-top:12px;max-width:100%;white-space:normal;text-align:left}\n#institutionalNewUser[hidden]{display:none}\n\n</style>\n<script id=\"forja-institutional-script\">\n/* Institutional configuration only. No Google secrets, direct Google calls or\n   independent synchronization loop. Native booking/drawer remain unchanged. */\n(function(){\n 'use strict';\n const CENTRAL='/admin/google-calendar/central',MODEL='institutional-events-v1';\n let catalog=null,catalogAt=0,catalogFlight=null,authorized=false,lastProfile=null;\n const adminView=()=>state.role==='admin'&&state.profile?.active===true;\n const current=s=>!!s&&forjaSessionCurrent(s)&&adminView();\n const beforeSession=forjaChangeSession;\n forjaChangeSession=function(...args){catalog=null;catalogAt=0;catalogFlight=null;authorized=false;lastProfile=null;return beforeSession(...args);};\n const beforeApi=api;\n api=async function(path,options={}){\n  const session=forjaSessionUID?forjaCaptureSession():null;let next=options;\n  if(adminView()&&options.method==='POST'&&['/admin/profissionais','/admin/usuarios'].includes(path)&&options.body?.role==='teacher'&&document.getElementById('newUserForm'))next={...options,body:{...options.body,calendarModel:MODEL,institutionalCalendarId:document.getElementById('newUserInstitutionalCalendar')?.value||''}};\n  if(adminView()&&options.method==='PATCH'&&path.startsWith(CENTRAL+'/calendars/')&&options.body?.teacherId!==undefined){const id=path.split('/').at(-1),row=catalog?.items?.find(r=>r.id===id);if(!row)throw Error('Atualize a lista de calendários antes de alterar o vínculo.');next={...options,body:{...options.body,expectedTeacherId:row.teacherId||''}};}\n  if(adminView()&&path===CENTRAL+'/connect'&&options.method==='POST'&&authorized)next={...options,body:{purpose:MODEL}};\n  const result=await beforeApi(path,next);\n  if(current(session)){\n   if(path===CENTRAL+'/status')authorized=result.item?.institutionalAuthorized===true;\n   if(path===CENTRAL+'/calendars'||options.method==='PATCH'&&path.startsWith(CENTRAL+'/calendars/')){catalog=result;catalogAt=Date.now();authorized=result.institutionalAuthorized===true;}\n   if(/^\\/admin\\/usuarios\\/[^/]+$/.test(path)&&result.user?.profile)lastProfile={uid:decodeURIComponent(path.split('/').at(-1)),profile:result.user.profile,session};\n   if(result.calendarLink)setTimeout(()=>{if(current(session))toast(result.calendarLink.status==='binding_required'?'Professor criado. Vincule e ative a agenda institucional antes de confirmar horários.':'Professor criado e calendário vinculado. A ativação e a confirmação institucional ainda estão pendentes.','warn');},0);\n  }\n  return result;\n };\n async function readCatalog(){\n  if(!adminView())throw Error('Sem permissão.');if(catalog&&Date.now()-catalogAt<60000)return catalog;\n  if(catalogFlight)return catalogFlight;const work=api(CENTRAL+'/calendars');catalogFlight=work;try{return await work;}finally{if(catalogFlight===work)catalogFlight=null;}\n }\n function optionsHtml(rows,uid=''){\n  const available=rows.filter(r=>r.accessStatus==='accessible'&&['owner','writer'].includes(r.accessRole)&&(!r.teacherId||r.teacherId===uid));\n  return '<option value=\"\">Vincular depois — horários não confirmados</option>'+available.map(r=>`<option value=\"${esc(r.id)}\" ${r.teacherId===uid&&uid?'selected':''}>${esc(r.displayName)} · ${esc(r.calendarId)}</option>`).join('');\n }\n async function activate(row,host){\n  if(!adminView()||!row?.teacherId||!authorized)return;\n  if(!confirm('Ativar a agenda institucional para este professor? A operação exige autorização de eventos, vínculo validado e sincronização inicial. Vínculos legados não serão removidos.'))return;\n  const session=forjaCaptureSession();host.disabled=true;\n  try{await api(CENTRAL+'/calendars/'+row.id,{method:'PATCH',body:{teacherId:row.teacherId,expectedTeacherId:row.teacherId,enabled:true,institutionalMode:true}});if(current(session)){host.textContent='Fonte selecionada; aguarde a confirmação na Agenda';toast('Fonte institucional selecionada. A Agenda só ficará disponível após confirmação das fontes.','ok');}}\n  catch(error){if(current(session)){host.disabled=false;toast(error.message,'warn');}}\n }\n async function newUserCalendar(){\n  const form=document.getElementById('newUserForm');if(!form||form.querySelector('#institutionalNewUser')||!adminView())return;\n  const session=forjaCaptureSession(),field=document.createElement('div');field.id='institutionalNewUser';field.className='nu-field nu-full';\n  field.innerHTML='<label for=\"newUserInstitutionalCalendar\">Agenda Google institucional</label><select id=\"newUserInstitutionalCalendar\" aria-describedby=\"institutionalNewUserHelp\"><option value=\"\">Vincular depois — horários não confirmados</option></select><small id=\"institutionalNewUserHelp\" role=\"status\">Consultando os calendários autorizados da Secretaria…</small>';\n  (form.querySelector('.nu-grid')||form.querySelector('#newUserControls')||form).append(field);\n  const updateRole=()=>{field.hidden=document.getElementById('newUserRole')?.value!=='teacher';};form.addEventListener('change',updateRole);updateRole();\n  try{const data=await readCatalog();if(!current(session)||!form.isConnected)return;field.querySelector('select').innerHTML=optionsHtml(data.items||[]);field.querySelector('small').textContent='Selecione pelo nome e ID do calendário. Não informe tokens. O vínculo é preparado; ativação e autorização de eventos são confirmadas pela Secretaria.';}\n  catch{if(current(session)&&form.isConnected)field.querySelector('small').textContent='Lista indisponível. É possível cadastrar e vincular depois; os horários institucionais permanecerão não confirmados.';}\n }\n const beforeNewUser=newUserModal;newUserModal=function(...args){const result=beforeNewUser(...args);void newUserCalendar();return result;};\n const beforeOpenUser=openUser;openUser=async function(uid,...args){const session=forjaCaptureSession();await beforeOpenUser(uid,...args);const modal=document.querySelector('#modal .modal');if(!current(session)||!modal?.querySelector('.admin-user-head')||lastProfile?.uid!==uid||lastProfile.profile.role!=='teacher'||modal.querySelector('#institutionalUserLink'))return;\n  const section=document.createElement('section');section.id='institutionalUserLink';section.className='p2-card';section.innerHTML='<h3>Agenda institucional do professor</h3><label for=\"institutionalUserCalendar\">Calendário autorizado</label><select id=\"institutionalUserCalendar\"><option>Consultando…</option></select><p role=\"status\">O vínculo não troca calendários nem remove eventos legados automaticamente.</p><button class=\"small-btn\" type=\"button\" disabled>Vincular calendário</button>';modal.append(section);\n  try{const data=await readCatalog();if(!current(session)||!section.isConnected)return;const select=section.querySelector('select'),button=section.querySelector('button'),existing=(data.items||[]).find(r=>r.teacherId===uid);select.innerHTML=optionsHtml(data.items||[],uid);button.disabled=!!existing;section.querySelector('p').textContent=existing?existing.institutionalMode?'Fonte institucional selecionada. Confira a confirmação atual na Agenda.':'Vínculo preparado. O modelo anterior permanece até a ativação institucional.':'Sem vínculo. Selecione um calendário livre para este professor.';\n   if(existing){select.disabled=true;button.textContent=existing.institutionalMode?'Fonte institucional selecionada':authorized?'Ativar fonte institucional':'Autorize eventos nas Configurações';if(!existing.institutionalMode&&authorized){button.disabled=false;button.onclick=()=>activate(existing,button);}}\n   else{button.disabled=false;button.onclick=async()=>{if(!select.value)return;button.disabled=true;try{await api(CENTRAL+'/calendars/'+select.value,{method:'PATCH',body:{teacherId:uid,expectedTeacherId:'',enabled:false}});if(current(session)&&section.isConnected){button.textContent='Vinculado; ative nas Configurações';select.disabled=true;section.querySelector('p').textContent='Vínculo preparado. A ativação institucional continua explícita.';}}catch(e){if(current(session)&&section.isConnected){button.disabled=false;section.querySelector('p').textContent=e.message;}}};}\n  }catch{if(current(session)&&section.isConnected)section.querySelector('p').textContent='Não foi possível consultar os vínculos. Nenhuma associação foi alterada.';}\n };\n const beforeAgendaPaint=window.forjaAgenda2Paint;\n window.forjaAgenda2Paint=function(...args){\n  const result=beforeAgendaPaint?.(...args),item=state.googleCalendar?.item||{};\n  if(window.forjaAgenda2Institutional?.()){\n   const box=document.querySelector('.v622-sync');\n   if(box){const title=box.querySelector('.sync-copy b'),copy=box.querySelector('.sync-copy span');if(title)title.textContent='Agenda institucional';if(copy)copy.textContent='Gerenciada pela Secretaria · Última sincronização: '+(item.sourceMode===MODEL&&item.lastSyncAt?fmtDateTime(item.lastSyncAt):'aguardando confirmação');for(const button of box.querySelectorAll('[data-google-action],[data-v620-google-diagnostics]'))button.remove();}\n   for(const notice of document.querySelectorAll('#workspaceContent [data-personal-google-status]'))notice.remove();\n  }\n  return result;\n };\n const beforeGooglePanel=googleCalendarPanel;googleCalendarPanel=function(...args){const item=state.googleCalendar?.item||{};if(window.forjaAgenda2Institutional?.())return `<section class=\"p2-card\"><small>AGENDA INSTITUCIONAL</small><h3>Calendário gerenciado pela Secretaria</h3><p>Você usa sua conta FORJA. A conexão e o vínculo Google são administrados pela escola.</p><p role=\"status\">${item.sourceMode===MODEL&&item.status==='success'&&item.initialSyncComplete?'Fonte institucional confirmada na última consulta. Confira o estado atual na Agenda.':'Vínculo, autorização ou sincronização inicial ainda pendentes. Horários não confirmados não são livres.'}</p></section>`;return beforeGooglePanel(...args);};\n function centralControls(){\n  if(!adminView()||state.page!=='configuracoes')return;const card=document.getElementById('googleSecretariaCard');if(!card||!catalog)return;\n  if(!card.querySelector('[data-institutional-consent]')){const b=document.createElement('button');b.className='small-btn';b.type='button';b.dataset.institutionalConsent='1';b.textContent=authorized?'Eventos institucionais autorizados':'Autorizar eventos institucionais';b.disabled=authorized;b.onclick=async()=>{const session=forjaCaptureSession();b.disabled=true;try{const r=await api(CENTRAL+'/connect',{method:'POST',body:{purpose:MODEL}});if(current(session)){const u=new URL(r.authUrl);if(u.origin!=='https://accounts.google.com')throw Error('Autorização inválida');location.assign(u.href);}}catch(e){if(current(session)){b.disabled=false;toast(e.message,'warn');}}};(card.querySelector('.quick-row')||card).append(b);const p=card.querySelector(':scope > p');if(p)p.textContent='A fonte institucional exige autorização de eventos, vínculo por professor e sincronização inicial. O modelo legado permanece disponível até a migração explícita.';}\n  for(const row of catalog.items||[]){const parent=card.querySelector('[data-central-professor=\"'+row.id+'\"]')?.closest('.central-calendar');if(!parent||parent.querySelector('[data-institutional-row]')||!row.teacherId)continue;const b=document.createElement('button');b.className='small-btn';b.type='button';b.dataset.institutionalRow=row.id;b.textContent=row.institutionalMode?'Fonte institucional selecionada; confira a Agenda':'Ativar fonte institucional';b.disabled=row.institutionalMode||!authorized||!['owner','writer'].includes(row.accessRole)||row.accessStatus!=='accessible';b.onclick=()=>activate(row,b);parent.append(b);}\n }\n const beforeBind=bindPage;bindPage=function(...args){const result=beforeBind(...args);centralControls();return result;};\n let queued=false;new MutationObserver(()=>{if(queued||!adminView()||state.page!=='configuracoes')return;queued=true;queueMicrotask(()=>{queued=false;centralControls();});}).observe(document.body,{childList:true,subtree:true});\n})();\n\n</script>\n</body>\n</html>",
