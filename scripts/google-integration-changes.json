    "before": "</body>",
    "after": "\n<script id=\"forja-google-personal-consent-script\">\n(function(){\n  'use strict';\n  const VERSION='personal-busy-secretaria-v1';\n  const PREVIEW_TEXT=\"Autorizo que a Secretaria consulte meus intervalos ocupados do Google Calendar para organizar agendamentos no FORJA. Pela interface FORJA, a Secretaria não recebe títulos, descrições ou participantes dos meus eventos pessoais. Aulas e atendimentos gerenciados pelo FORJA continuam sincronizados nos dois sentidos. Eu continuo controlando minha disponibilidade; Google ocupado nunca cria disponibilidade.\";\n  const readonlyPreview=()=>/^forja-escola--[a-z0-9-]+-[a-z0-9]{8}\\.web\\.app$/.test(location.hostname);\n  const previousAction=googleAction,previousPanel=googleCalendarPanel;\n  googleCalendarPanel=function(){\n    const original=previousPanel();if(!['teacher','psychologist'].includes(state.role))return original;\n    if(readonlyPreview())return original+`<section class=\"p2-card\"><h3>Revisão do consentimento pessoal</h3><p>Este Preview é somente leitura. Nenhuma autorização Google será gravada.</p><button class=\"small-btn\" data-google-action=\"consent\">Revisar consentimento (Preview)</button></section>`;\n    const item=state.googleCalendar?.item||{};\n    if(!item.connected||item.personalConsent?.accepted)return original;\n    return original+`<section class=\"p2-card\"><h3>Consulta de ocupados pela Secretaria</h3><p>Sua conexão pessoal continua funcionando. A consulta de horários pela Secretaria depende do seu aceite explícito. Até regularizar, a consulta fica indisponível; isso não significa horário livre.</p><button class=\"small-btn\" data-google-action=\"consent\">Revisar e autorizar</button></section>`;\n  };\n  googleAction=async function(action,button){\n    if(readonlyPreview()){\n      if(['connect','consent'].includes(action))modal('Prévia do consentimento Google',`<p>${esc(PREVIEW_TEXT)}</p><label style=\"display:flex;gap:10px\"><input type=\"checkbox\"><span>Li e autorizo a consulta de intervalos ocupados pela Secretaria.</span></label><p role=\"status\">Prévia somente para revisão. Nenhum aceite é gravado e nenhuma operação Google pessoal é executada, pois o Firebase é compartilhado com a produção.</p>`);\n      else toast('Operações Google pessoais bloqueadas neste Preview compartilhado.','bad');\n      return;\n    }\n    if(!['connect','consent'].includes(action))return previousAction(action,button);\n    if(!['teacher','psychologist'].includes(state.role)||state.profile?.active===false)return;\n    const session=forjaCaptureSession();setBusy(button,true,'Verificando...');\n    try{\n      const status=await api('/google/calendar/status',{session}),policy=status.consent;forjaAssertSession(session);\n      if(policy?.version!==VERSION||!policy.text)throw new Error('O backend ainda não suporta o consentimento versionado. Aguarde a atualização segura.');\n      const reconnect=action==='connect'||status.item?.personalConsent?.requiresReconnect===true||!policy.connectionChallenge;\n      let submitted=false;\n      modal('Autorizar consulta à Secretaria',`<p>${esc(policy.text)}</p><p>Versão: ${esc(policy.version)}. O aceite será vinculado ao seu usuário e à identidade Google verificada. ${reconnect?'O Google solicitará sua autorização; cancelar não substitui sua conexão anterior.':'Esta confirmação mantém sua conexão atual.'}</p><label style=\"display:flex;align-items:flex-start;gap:10px\"><input id=\"googlePersonalConsentAccept\" type=\"checkbox\"><span>Li e autorizo a consulta de intervalos ocupados pela Secretaria, conforme o texto acima.</span></label><p id=\"googlePersonalConsentFeedback\" role=\"status\"></p>`,reconnect?'Aceitar e continuar no Google':'Confirmar autorização',async save=>{\n        if(!forjaSessionCurrent(session)||submitted||!document.getElementById('googlePersonalConsentAccept')?.checked)return;\n        submitted=true;setBusy(save,true,'Registrando...');\n        try{\n          const consent={accepted:true,version:VERSION};\n          if(reconnect){const result=await api('/google/calendar/connect',{method:'POST',body:{consent},session});forjaAssertSession(session);const target=new URL(result.authUrl);if(target.origin!=='https://accounts.google.com'||target.pathname!=='/o/oauth2/v2/auth')throw new Error('URL Google inválida');location.assign(target.href);return;}\n          await api('/google/calendar/consent',{method:'POST',body:{...consent,connectionChallenge:policy.connectionChallenge},session});forjaAssertSession(session);\n          closeModal();toast('Autorização registrada para sua conexão Google atual.','ok');await reloadAndRender();\n        }catch(_){if(!forjaSessionCurrent(session))return;submitted=false;const feedback=document.getElementById('googlePersonalConsentFeedback');if(feedback)feedback.textContent='Não foi possível confirmar. Nenhuma nova autorização foi concedida. Reabra esta janela para conferir a conexão atual.';setBusy(save,false);}\n      });\n      const check=document.getElementById('googlePersonalConsentAccept'),save=document.getElementById('modalSave');\n      save.disabled=true;check.onchange=()=>{save.disabled=!check.checked||submitted;};\n    }catch(_){if(!forjaSessionCurrent(session))return;toast('Não foi possível preparar o consentimento. Nenhuma autorização foi concedida.','bad');}finally{if(forjaSessionCurrent(session))setBusy(button,false);}\n  };\n  const previousAgenda=forjaAgendaPage;\n  forjaAgendaPage=function(){const page=previousAgenda();return state.role==='admin'&&state.googleBusyUnavailable?`<div class=\"system-note\" role=\"status\">Consulta Google de um ou mais profissionais indisponível. Verifique o consentimento e a sincronização. Ausência de blocos não comprova horário livre.</div>`+page:page;};\n})();\n</script>\n</body>",
