    "after": "\n<script id=\"forja-google-personal-disconnect-script\">\nfunction googlePersonalDisconnectResult(value){\n  if(!['completed','partial','failed'].includes(value?.outcome))return null;\n  const choose=(v,allowed)=>allowed.includes(v)?v:'unknown';\n  const result={outcome:value.outcome,ok:value.ok===true,retryable:value.retryable===true,\n    local:{connection:choose(value.local?.connection,['deleted','failed','retained','not_attempted','changed']),busy:choose(value.local?.busy,['deleted','failed','not_attempted'])},\n    google:{revocation:choose(value.google?.revocation,['revoked','not_needed','failed','unavailable','deferred_shared_project']),webhook:choose(value.google?.webhook,['stopped','not_needed','failed'])}};\n  if(result.local.connection==='deleted'&&result.local.busy!=='deleted')return null;\n  if(result.outcome==='completed'&&(!result.ok||result.local.connection!=='deleted'||!['revoked','not_needed'].includes(result.google.revocation)||!['stopped','not_needed'].includes(result.google.webhook)))return null;\n  return result;\n}\n(function(){\n  'use strict';\n  const previousAction=googleAction,previousPanel=googleCalendarPanel;let pendingSession=null;\n  googleCalendarPanel=function(){\n    const original=previousPanel();if(!['teacher','psychologist'].includes(state.role)||!state.googleCalendar?.item?.disconnectPending)return original;\n    return original.replace('data-google-action=\"connect\"','data-google-action=\"connect\" disabled')+`<section class=\"p2-card\"><h3>Desconexão ainda pendente</h3><p>A conexão está suspensa. A exclusão local ainda precisa ser confirmada. Aulas, atendimentos e histórico permanecem preservados.</p><button class=\"small-btn danger-btn\" data-google-action=\"disconnect\">Tentar concluir desconexão</button></section>`;\n  };\n  googleAction=async function(action,button){\n    if(action!=='disconnect')return previousAction(action,button);\n    if(/^forja-escola--[a-z0-9-]+-[a-z0-9]{8}\\.web\\.app$/.test(location.hostname)){toast('Desconexão real bloqueada no Preview compartilhado. Nenhuma conta foi alterada.','warn');return;}\n    if(pendingSession&&forjaSessionCurrent(pendingSession)||!['teacher','psychologist'].includes(state.role))return;const session=forjaCaptureSession();\n    if(!confirm('Desconectar somente sua integração pessoal no FORJA? Aulas e histórico serão preservados. A revogação global Google será tratada separadamente para preservar outras integrações.'))return;\n    pendingSession=session;setBusy(button,true,'Desconectando...');let result=null;\n    try{result=googlePersonalDisconnectResult(await api('/google/calendar/connection',{method:'DELETE',session}));}\n    catch(error){result=googlePersonalDisconnectResult(error?.disconnectResult);}\n    try{\n      if(!forjaSessionCurrent(session))return;\n      if(!result){toast('Não foi possível confirmar a desconexão. Confira sua conexão e tente novamente.','bad');return;}\n      if(result.local.connection==='changed')toast('A conexão mudou durante a operação. Confira o estado atual antes de desconectar novamente.','bad');\n      else if(result.outcome==='completed')toast('Desconexão local confirmada. Permissões Google são tratadas separadamente.','ok');\n      else if(result.local.connection==='deleted'){\n        toast('Desconexão local concluída; encerramento no Google pendente.','warn');\n        modal('Resultado da desconexão',`<p>A credencial local e os intervalos em cache foram removidos. Aulas, atendimentos e histórico foram preservados.</p><p>A revogação global Google não foi confirmada. Revogar um grant pode afetar todos os clientes OAuth do mesmo projeto para sua conta, incluindo outras integrações. Confirme o impacto com a escola antes de revogar permissões no Google.</p>`);\n      }else toast(result.outcome==='failed'?'Falha ao iniciar ou confirmar a desconexão. Tente novamente.':'Desconexão parcial: exclusão local pendente. A conexão está suspensa; use Tentar concluir desconexão.','bad');\n      try{await reloadAndRender();}catch(_){toast('Resultado registrado, mas o status visual não pôde ser atualizado. Recarregue para conferir a conexão.','warn');}\n    }finally{if(pendingSession===session)pendingSession=null;if(forjaSessionCurrent(session))setBusy(button,false);}\n  };\n})();\n</script>\n</body>",
